# ==============================================================================
# HIMNOVA TECHNOLOGIES — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your actual EmailJS credentials.
# ==============================================================================

# Target Live Website Domain URL
NEXT_PUBLIC_SITE_URL=https://www.himnovatech.com

# ------------------------------------------------------------------------------
# Service 1: Contact Form Service (2 Templates)
# Find Public Key in EmailJS Account settings for this account
# ------------------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_CONTACT_SERVICE_ID=your_contact_service_id_here
NEXT_PUBLIC_EMAILJS_CONTACT_PUBLIC_KEY=your_contact_public_key_here
NEXT_PUBLIC_EMAILJS_CONTACT_ADMIN_TEMPLATE_ID=your_contact_admin_template_id_here
NEXT_PUBLIC_EMAILJS_CONTACT_CLIENT_TEMPLATE_ID=your_contact_client_template_id_here

# ------------------------------------------------------------------------------
# Service 2: Job Application Service (2 Templates)
# Find Public Key in EmailJS Account settings for this account
# ------------------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_CAREER_SERVICE_ID=your_career_service_id_here
NEXT_PUBLIC_EMAILJS_CAREER_PUBLIC_KEY=your_career_public_key_here
NEXT_PUBLIC_EMAILJS_CAREER_ADMIN_TEMPLATE_ID=your_career_admin_template_id_here
NEXT_PUBLIC_EMAILJS_CAREER_CANDIDATE_TEMPLATE_ID=your_career_candidate_template_id_here

# ------------------------------------------------------------------------------
# Global Fallback Public Key (Optional if same account is used for both)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_shared_public_key_here
